rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Slugs reverse lookup collection (slug -> ownerUid)
    match /slugs/{slug} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Multi-Tenant Restaurants collection
    match /restaurants/{ownerUid} {
      allow read: if true; // Public can read restaurant info
      allow write: if isOwner(ownerUid);

      // Menu subcollection
      match /menu/{itemId} {
        allow read: if true; // Public customer can browse menu
        allow write: if isOwner(ownerUid);
      }

      // Coupons subcollection
      match /coupons/{couponId} {
        allow read: if true; // Public customer can view active coupons
        allow write: if isOwner(ownerUid);
      }

      // Orders subcollection
      match /orders/{orderId} {
        allow create: if true; // Any customer can place an order
        allow read: if isOwner(ownerUid) || true; // Customer & owner can read
        allow update, delete: if isOwner(ownerUid);
      }
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || !exists(/databases/$(database)/documents/users/$(userId));
    }

    // User activity logs collection
    match /user_logs/{logId} {
      allow create: if true;
      allow read: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Legacy fallback collections
    match /orders/{orderId} {
      allow read, create, update: if true;
    }
    match /restaurant_settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /menu_catalog/{itemId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
